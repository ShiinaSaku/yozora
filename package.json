    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "packageManager": "bun@1.4.4"
