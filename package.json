    "@hugeicons/react": "^1.1.10",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/highlight": "^0.1.0",
    "@tanstack/markdown": "^0.0.15",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.32.0",
    "sonner": "^2.0.8",
    "svix": "^2.5.0",
    "takumi-js": "^2.14.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1",
    "zod": "^4.6.5"
