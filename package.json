    "@hugeicons/react": "^1.1.10",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/highlight": "^1.2.12",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "graphql": "^17.1.0",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.37.0",
    "sonner": "^2.0.8",
    "svix": "^2.10.0",
    "takumi-js": "^2.20.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@graphql-codegen/schema-ast": "^7.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-config": "^0.5.0",
