{
  "name": "yozora",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsc --noEmit",
    "preview": "wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "astro check",
    "graphql:env": "gql-tada generate-output",
    "graphql:schema": "gql-tada generate-schema --output ./schema.graphql https://okotsuu.vercel.app/graphql && gql-tada generate-schema --output ./schemas/animethemes.graphql --header \"User-Agent: Yozora/1.0 (https://yozora.moe)\" https://rs.animethemes.moe/graphql",
    "graphql:doctor": "gql-tada doctor",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@base-ui/react": "^1.9.0",
    "@clerk/astro": "^4.1.24",
    "@clerk/ui": "^1.42.6",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@neondatabase/serverless": "^1.2.1",
    "@tanstack/highlight": "^1.2.12",
    "@tanstack/markdown": "^1.2.0",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "^7.5.0",
    "gql.tada": "^1.11.5",
    "graphql": "^17.1.0",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "simple-icons": "^16.37.0",
    "sonner": "^2.0.8",
    "svix": "^2.10.0",
    "takumi-js": "^2.20.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-config": "^0.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "packageManager": "bun@1.4.4"
}
