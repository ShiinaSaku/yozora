---
/**
 * Base document layout. Owns the full head layer (meta, SEO, JSON-LD, fonts,
 * preconnects), the blocking theme script, and the shared chrome (navbar,
 * footer, toaster, theme hotkey).
 *
 * Per-page metadata: pass `title`/`description`/`keywords`, optional
 * `links` (canonical/preloads) and `jsonLd` (script contents, already
 * stringified).
 */
import { ClientRouter } from "astro:transitions"
import { Font } from "astro:assets"
import type { ComponentProps } from "react"
import "@/styles/globals.css"
import {
  generateDatasetJsonLd,
  generateOrganizationJsonLd,
  generateSoftwareApplicationJsonLd,
  generateWebSiteJsonLd,
  stringifyJsonLd,
} from "@/lib/seo/json-ld"
import { HIDDEN_FOOTER_ROUTES } from "@/components/layout/footer"
import { Navbar } from "@/components/layout/navbar.tsx"
import { Footer } from "@/components/layout/footer.tsx"
import ThemeHotkey from "@/components/theme-hotkey.tsx"
import { Toaster } from "@/components/ui/sonner.tsx"
import { absoluteUrl, openGraphImageUrl } from "@/lib/seo/meta"

interface BaseLayoutProps {
  title?: string
  description?: string
  keywords?: string
  /** Per-page JSON-LD script bodies (already stringified). */
  jsonLd?: string[]
  /** Per-page <link> tags (canonical, image preloads, ...). */
  links?: ComponentProps<"link">[]
  robots?: string
  /** Absolute Open Graph / Twitter image URL. */
  image?: string
  imageAlt?: string
  ogType?: string
}

const props = Astro.props as BaseLayoutProps

const defaultTitle = "Yozora — Discover Anime, Schedules & Themes"
const defaultDescription =
  "Discover seasonal anime, follow upcoming episodes, explore opening and ending themes, and keep track of your watchlist on Yozora."

const title = props.title ?? defaultTitle
const description = props.description ?? defaultDescription
const keywords =
  props.keywords ??
  "Yozora, Yozora anime, yozora.moe, anime, anime catalog, seasonal anime 2026, anime schedule, anime countdown, anime airing countdown, creditless OP ED, anime soundtracks, anime openings, anime endings, anime watchlist, seiyuu, voice actors, 夜空, アニメ, 放送スケジュール, 今期アニメ, 新番, 追番, 主題歌, 声優, AniList, MyAnimeList"

const siteJsonLd = [
  stringifyJsonLd(generateOrganizationJsonLd()),
  stringifyJsonLd(generateWebSiteJsonLd()),
  stringifyJsonLd(generateSoftwareApplicationJsonLd()),
  stringifyJsonLd(generateDatasetJsonLd()),
]

const pageJsonLd = props.jsonLd ?? []
const pageLinks = props.links ?? []
const canonicalUrl =
  pageLinks.find((link) => link.rel === "canonical")?.href ??
  absoluteUrl(Astro.url.pathname)
const socialImage =
  props.image ?? openGraphImageUrl({ type: "home", title: "Yozora" })
const socialImageAlt = props.imageAlt ?? "Yozora — discover your next anime"
const pathname = Astro.url.pathname
const hideFooter = HIDDEN_FOOTER_ROUTES.some((route) =>
  pathname.startsWith(route)
)
---

<!doctype html>
<html lang="en" suppressHydrationWarning>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="application-name" content="Yozora" />
    <meta name="apple-mobile-web-app-title" content="Yozora" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="msapplication-TileColor" content="#06070b" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#06070b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta
      name="robots"
      content={props.robots ??
        "index, follow, max-image-preview:large, max-video-preview:-1, max-snippet:-1"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Yozora" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={props.ogType ?? "website"} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <Font cssVariable="--font-capriola" preload />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-space-mono" />
    <Font cssVariable="--font-zen-maru" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="text/markdown"
      href="/llms.txt"
      title="LLM Context (llms.txt)"
    />
    <link
      rel="alternate"
      type="text/markdown"
      href="/llms-full.txt"
      title="Full LLM Context & Schema (llms-full.txt)"
    />
    <link
      rel="alternate"
      type="text/markdown"
      href="/pricing.md"
      title="Pricing & Open Access Specification (pricing.md)"
    />
    <link
      rel="search"
      type="application/opensearchdescription+xml"
      title="Search Yozora Anime"
      href="/opensearch.xml"
    />
    <link rel="preconnect" href="https://s4.anilist.co" />
    <link rel="preconnect" href="https://cdn.myanimelist.net" />
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="preconnect" href="https://v.animethemes.moe" />
    <link rel="dns-prefetch" href="https://s4.anilist.co" />
    <link rel="dns-prefetch" href="https://cdn.myanimelist.net" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />
    <link rel="dns-prefetch" href="https://v.animethemes.moe" />

    {pageLinks.map((link) => <link {...link} />)}

    {siteJsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}
    {pageJsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const applyTheme = () => {
        const isDark = getThemePreference() === 'dark';
        document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
      };
      applyTheme();

      if (typeof localStorage !== 'undefined') {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }

      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased">
    <ThemeHotkey client:load />
    <Toaster client:load />
    <Navbar client:load />
    <main class="flex-1">
      <slot />
    </main>
    {hideFooter ? null : <Footer client:visible />}
  </body>
</html>
