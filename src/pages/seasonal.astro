---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { SeasonalClient } from "@/components/pages/seasonal-client"
import {
  generateBreadcrumbsJsonLd,
  generateSeasonalJsonLd,
  stringifyJsonLd,
} from "@/lib/seo/json-ld"
import { getSeasonalData } from "@/lib/server/catalog"
import { canonicalLinks } from "@/lib/seo/meta"

export const prerender = false

const items = await getSeasonalData()
const seasonalYear = new Date().getFullYear()
const topAnime = Array.isArray(items) ? items[0] : undefined

const links = [
  ...canonicalLinks("/seasonal"),
  ...(topAnime?.coverLarge || topAnime?.cover
    ? [
        {
          rel: "preload",
          as: "image",
          href: topAnime.coverLarge || topAnime.cover,
          fetchpriority: "high",
        },
      ]
    : []),
]

const jsonLd = [
  stringifyJsonLd(
    generateBreadcrumbsJsonLd([
      { name: "Home", url: "/" },
      { name: "Seasonal Anime", url: "/seasonal" },
    ])
  ),
  ...(Array.isArray(items) && items.length > 0
    ? [stringifyJsonLd(generateSeasonalJsonLd(items, seasonalYear))]
    : []),
]
---

<BaseLayout
  title="Seasonal Anime Chart — Current & Upcoming Anime | Yozora"
  description="Explore seasonal anime charts, discover new and upcoming releases, and find your next series on Yozora."
  keywords={`seasonal anime, seasonal anime chart, winter anime ${seasonalYear}, spring anime ${seasonalYear}, summer anime ${seasonalYear}, fall anime ${seasonalYear}, top anime season, anime schedule, 今期アニメ, 新作アニメ, 新番, 追番, 放送予定, Yozora anime`}
  links={links}
  jsonLd={jsonLd}
>
  <SeasonalClient client:load items={items} />
</BaseLayout>
