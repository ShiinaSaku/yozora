{
  "extends": "astro/tsconfigs/strict",
  "include": ["**/*.ts", "**/*.tsx", ".astro/types.d.ts", "eslint.config.js", "astro.config.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["vite/client"],
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schemas": [
          {
            "name": "anilist",
            "schema": "./schema.graphql",
            "tadaOutputLocation": "./src/graphql/anilist-env.d.ts"
          },
          {
            "name": "themes",
            "schema": "./schemas/animethemes.graphql",
            "tadaOutputLocation": "./src/graphql/themes-env.d.ts"
          }
        ]
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
