{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yozora",
	"compatibility_date": "2026-09-28",
	"workers_dev": false,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	},
	"routes": [
		{
			"pattern": "yozora.moe",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"preview_urls": false,
	"vars": {
		"PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsueW96b3JhLm1vZSQ"
	}
}