{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yozora",
	"compatibility_date": "2026-09-19",
	"workers_dev": false,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"routes": [
		{
			"pattern": "yozora.moe",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"preview_urls": false
}
